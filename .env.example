# Copy to .env.local and fill in. Never commit .env.local (already
# git-ignored) or paste real values into a shared chat/PR description.

# --- Supabase --------------------------------------------------------------
# Local: run `pnpm db:start`, then `npx supabase status` prints these.
# Hosted dev/prod project: Project Settings -> API in the Supabase dashboard.

# Safe to expose to the browser — protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# import outside lib/supabase/admin.ts (that file's `server-only` import
# turns an accidental client-side import into a build error). Get this from
# the *server* environment (Vercel project settings), not from a file that
# gets committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Used to build absolute URLs (auth redirects, generated links). No
# trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests only ----------------------------------------------------------
# Direct Postgres connection (NOT the service_role API key) used only by
# tests/helpers.ts fixture setup/teardown, against the DEV project only.
# Never add this to Vercel (any environment) and never point it at PROD —
# it's a local/CI test-runner secret, not an app runtime one. Get the URI
# from the DEV project's Supabase dashboard: Project Settings -> Database
# -> Connection string ("URI" tab, direct connection or session pooler
# both work). Deliberately kept separate from SUPABASE_SERVICE_ROLE_KEY:
# fixture setup needs real table access for cross-tenant test data that
# RLS-scoped clients can't create, and giving that access at the Postgres
# role level (via this connection's own privileges) instead of widening
# service_role's grants keeps the production grant surface unaffected by
# test infrastructure needs. See supabase/migrations/README.md.
TEST_DATABASE_URL=
