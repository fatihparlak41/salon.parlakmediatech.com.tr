# Copy to .env.local and fill in. Never commit .env.local (already
# git-ignored) or paste real values into a shared chat/PR description.

# --- Supabase --------------------------------------------------------------
# Local: run `pnpm db:start`, then `npx supabase status` prints these.
# Hosted dev/prod project: Project Settings -> API in the Supabase dashboard.

# Safe to expose to the browser — protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# import outside lib/supabase/admin.ts (that file's `server-only` import
# turns an accidental client-side import into a build error). Get this from
# the *server* environment (Vercel project settings), not from a file that
# gets committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Used to build absolute URLs (auth redirects, generated links). No
# trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
